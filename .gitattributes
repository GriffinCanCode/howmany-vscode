# Normalize line endings on checkin; check out with native endings.
* text=auto eol=lf

*.ts      text
*.js      text
*.json    text
*.jsonc   text
*.md      text diff=markdown
*.css     text diff=css
*.html    text diff=html
*.yml     text
*.yaml    text
*.sh      text eol=lf
*.bat     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.svg     text
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary

# Packaged extension bundles - never diff, never count as source.
*.vsix              binary linguist-generated=true -diff
package-lock.json   linguist-generated=true -diff

/.github/        export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.editorconfig   export-ignore
/.vscode/        export-ignore
/test-project/   export-ignore
